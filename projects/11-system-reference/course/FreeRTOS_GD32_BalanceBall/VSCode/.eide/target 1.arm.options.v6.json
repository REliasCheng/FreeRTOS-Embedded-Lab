{
    "version": 3,
    "beforeBuildTasks": [],
    "afterBuildTasks": [
        {
            "name": ".\\keil5_disp_size_bar.exe",
            "command": "cd .\\..\\Project && .\\keil5_disp_size_bar.exe",
            "disable": false,
            "abortAfterFailed": true
        }
    ],
    "global": {
        "use-microLIB": true,
        "output-debug-info": "enable"
    },
    "c/cpp-compiler": {
        "optimization": "level-1",
        "language-c": "c99",
        "language-cpp": "c++11",
        "link-time-optimization": false,
        "one-elf-section-per-function": true,
        "plain-char-is-signed": true,
        "short-enums#wchar": true,
        "warnings": "ac5-like-warnings",
        "C_FLAGS": "-Wno-invalid-source-encoding",
        "CXX_FLAGS": "-Wno-invalid-source-encoding"
    },
    "asm-compiler": {
        "$use": "asm-auto"
    },
    "linker": {
        "output-format": "elf",
        "misc-controls": "--diag_suppress=L6329",
        "xo-base": "",
        "ro-base": "0x08000000",
        "rw-base": "0x20000000"
    }
}